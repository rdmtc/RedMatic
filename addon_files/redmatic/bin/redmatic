#!/bin/sh

CONF_DIR=/usr/local/etc/config
ADDON_DIR=/usr/local/addons/redmatic
WWW_DIR=/usr/local/etc/config/addons/www/redmatic

NODE=$ADDON_DIR/bin/node

SETTINGS=$ADDON_DIR/lib/settings.js
RED_DIR=$ADDON_DIR/lib/node_modules/node-red
RED=$RED_DIR/red.js

# No LD_LIBRARY_PATH here: the bundled binaries find their (musl) libraries
# via their patched RPATH; exposing $ADDON_DIR/lib globally could poison
# glibc firmware binaries with same-named musl libraries.
export PATH=$ADDON_DIR/bin:$PATH
export NO_UPDATE_NOTIFIER=true
export GIT_EXEC_PATH=$ADDON_DIR/libexec/git-core
export GIT_TEMPLATE_DIR=$ADDON_DIR/share/git-core/templates

# provides NODE_VERSION, VERSION_ADDON, RED_VERSION and (armv7l) ICU_DATA
. $ADDON_DIR/versions

Stop () {
    if [ -f /usr/bin/monit ]; then
        /usr/bin/monit -g redmatic unmonitor
    fi

    PSPID=`ps -o pid,comm,args | awk '{if($3 == "node-red" || $4 ~ /node-red/){print $1}}'`
    if [ "$PSPID" != "" ]; then
        echo -n "Stopping Node-RED: "
        logger -t redmatic -p daemon.info "Stopping Node-RED"

        killall redmaticLoader 2>/dev/null
        kill -SIGINT $PSPID 2>/dev/null
        sleep 2
        if kill -0 $PSPID 2> /dev/null
        then
            sleep 4
            if kill -0 $PSPID 2> /dev/null
            then
                logger -t redmatic -p daemon.warn "Killing Node-RED"
                kill -SIGKILL $PSPID 2>/dev/null
            fi
        fi
        echo "OK"
        logger -t redmatic -p daemon.info "Node-RED stopped"
        return 0
    else
        echo "Node-RED not running"
        return 1
    fi
}

# Matter controllers reach a bridge over IPv6 only. On the CCU3 with the
# original firmware eth0 (USB NIC) comes up before IPv6 is ready, so the
# link-local address (fe80::) is missing after boot (ROADMAP task 9).
# Re-enabling IPv6 on the interface creates it; duplicate address
# detection takes about two seconds. Harmless when the address exists.
EnsureIpv6LinkLocal () {
    IFACE=eth0
    IPV6_DISABLE=/proc/sys/net/ipv6/conf/$IFACE/disable_ipv6
    if [ ! -f $IPV6_DISABLE ]; then
        logger -t redmatic -p daemon.info "IPv6: no $IFACE or no IPv6 support, link-local check skipped"
        return
    fi
    if [ "`cat $IPV6_DISABLE`" = "1" ]; then
        logger -t redmatic -p daemon.info "IPv6 is disabled on $IFACE, leaving it alone (Matter needs IPv6)"
        return
    fi
    if ip -6 addr show dev $IFACE 2>/dev/null | grep -q "inet6 fe80:"; then
        logger -t redmatic -p daemon.info "IPv6 link-local address on $IFACE present"
        return
    fi
    echo 1 > $IPV6_DISABLE 2>/dev/null
    echo 0 > $IPV6_DISABLE 2>/dev/null
    i=0
    while [ $i -lt 10 ]; do
        if ip -6 addr show dev $IFACE 2>/dev/null | grep "inet6 fe80:" | grep -qv tentative; then
            logger -t redmatic -p daemon.info "IPv6 link-local address on $IFACE created (DAD took ${i}s)"
            return
        fi
        sleep 1
        i=$((i + 1))
    done
    logger -t redmatic -p daemon.warn "IPv6 link-local address on $IFACE still missing after re-enabling IPv6"
}

Start () {
    CCU_BACKUP=`$NODE -e "try { console.log(JSON.parse(require('fs').readFileSync('$ADDON_DIR/etc/settings.json', 'utf8')).ccuBackup || '') } catch (e) { console.log('') }"`
    for dir in bin include lib share tmp www; do
        if [ ! -d $ADDON_DIR/$dir ]; then
            continue
        fi
        if [ "$CCU_BACKUP" = "full" ]; then
            rm $ADDON_DIR/$dir/.nobackup 2>/dev/null
        else
            touch $ADDON_DIR/$dir/.nobackup
        fi
    done

    if [ ! -f /etc/config/rdmtc.uuid ]; then
        /usr/bin/uuidgen > /etc/config/rdmtc.uuid
    fi
    /usr/local/addons/redmatic/bin/redmaticVersions | /usr/bin/curl -H "Content-Type: application/json" -H "X-RedMatic-uuid: `cat /etc/config/rdmtc.uuid`" --data @- -s --max-time 3 https://telemetry.redmatic.de

    # quarantine corrupted context-store files that would prevent
    # Node-RED from starting (#452)
    $ADDON_DIR/bin/checkContext 2>&1 | logger -t redmatic -p daemon.warn

    PSPID=`ps -o pid,comm,args | awk '{if($3 == "node-red" || $4 ~ /node-red/){print $1}}'`
    if [ "$PSPID" != "" ]; then
        echo "Node-RED already running"
        logger -t redmatic -p daemon.error "cant start - already running"
        exit 1
    else
        upSeconds="$(cat /proc/uptime | grep -o '^[0-9]\+')"
        if [ "${upSeconds}" -lt "120" ]; then
              logger -t redmatic -p daemon.info "Starting Node-RED after reboot ... waiting 30 seconds..."
              echo "Starting Node-RED ... waiting 30 seconds..."
              sleep 30
        fi
        EnsureIpv6LinkLocal
        echo -n "Starting Node-RED: "
        logger -t redmatic -p daemon.info "RedMatic v$VERSION_ADDON (c) Sebastian Raff https://github.com/rdmtc/RedMatic"
        # Node-RED must not inherit a working directory that can vanish (the
        # OpenCCU installer's temp dir): spawning npm from a deleted cwd fails
        # and Node-RED disables the palette editor (#599)
        cd /
        start-stop-daemon -S -q -b --exec $ADDON_DIR/bin/redmaticLoader
        echo "OK"
    fi

    if [ -f /usr/bin/monit ]; then
        # set the monit memory alert limit relative to the machine's RAM:
        # half of MemTotal, at least 200 MB (#271)
        MEMTOTAL_KB=`grep MemTotal /proc/meminfo | awk '{print $2}'`
        if [ -n "$MEMTOTAL_KB" ] && [ -f $ADDON_DIR/etc/monit.tmpl ]; then
            MEMLIMIT=$((MEMTOTAL_KB / 2048))
            if [ $MEMLIMIT -lt 200 ]; then
                MEMLIMIT=200
            fi
            sed "s/@MEMLIMIT@/$MEMLIMIT/" $ADDON_DIR/etc/monit.tmpl > $ADDON_DIR/etc/monit.cfg.new
            if cmp -s $ADDON_DIR/etc/monit.cfg.new $ADDON_DIR/etc/monit.cfg; then
                rm $ADDON_DIR/etc/monit.cfg.new
            else
                mv $ADDON_DIR/etc/monit.cfg.new $ADDON_DIR/etc/monit.cfg
                /usr/bin/monit reload
            fi
        fi
        nohup $ADDON_DIR/bin/monit-start > /dev/null 2>&1 &
    fi
}

case "$1" in

    stop)
        Stop || exit 1
    ;;

    start)
        Start
    ;;

    restart)
        Stop
        sleep 3
        Start
    ;;

    info)
        . $ADDON_DIR/versions
        echo "Info: <div><a target=\"_blank\" href=\"https://github.com/rdmtc/RedMatic\"><img src=\"/addons/redmatic/redmatic5-wide.png\" height=\"48\"/></a></div>"
        echo "Name: RedMatic"
        echo "Version: $VERSION_ADDON"
        echo "Update: /addons/redmatic/update_check.cgi"
        echo "Config-Url: /addons/redmatic/settings.cgi"
        echo "Operations: restart uninstall"
    ;;

    uninstall)
        Stop

        $ADDON_DIR/bin/update_addon redmatic
        rm -r $ADDON_DIR
        rm -r $WWW_DIR
        rm $CONF_DIR/lighttpd/redmatic.conf
        rm $CONF_DIR/rc.d/redmatic

        # -L: the symlink is already dangling here because the addon dir is
        # gone, so a -f test would miss it and monit would keep a stale
        # config forever (#521)
        if [ -L /usr/local/etc/monit-redmatic.cfg ] || [ -f /usr/local/etc/monit-redmatic.cfg ]; then
            rm /usr/local/etc/monit-redmatic.cfg
            if [ -f /usr/bin/monit ]; then
                /usr/bin/monit reload
            fi
        fi

        logger -t redmatic -p daemon.info "Uninstalled RedMatic"
    ;;

    *)
        echo "Usage: node-red {start|stop|restart|info|uninstall}" >&2
        exit 1
    ;;

esac

exit 0
