{
  "name": "redmatic",
  "version": "9.3.0",
  "description": "Node-RED packaged as Homematic CCU addon",
  "repository": "github:rdmtc/redmatic",
  "private": true,
  "main": "none",
  "engines": {
    "node": "24.20.0"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "5.15.4",
    "bcryptjs": "2.4.3",
    "bootstrap": "4.6.1",
    "jquery": "3.6.0",
    "node-red": "5.0.6",
    "node-red-contrib-ccu": "4.3.0",
    "npm": "11.19.1"
  },
  "author": "Sebastian Raff <hobbyquaker@gmail.com>",
  "license": "Apache-2.0",
  "scripts": {
    "build": "./build.sh",
    "build:armv7l": "./build_addon.sh armv7l",
    "build:aarch64": "./build_addon.sh aarch64",
    "build:x86_64": "./build_addon.sh x86_64",
    "outdated": "npm outdated --prefix addon_files/redmatic/lib; npm outdated --prefix addon_files/redmatic/var; npm outdated --prefix addon_files/redmatic/www; true",
    "update:package": "node update_package.js",
    "update:readme": "node update_readme.js",
    "update:versions": "node update_versions.js",
    "test:e2e": "test/e2e.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1"
  }
}
